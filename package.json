{
  "name": "veeranjali",
  "version": "1.0.0",
  "private": true,
  "description": "A digital memorial and knowledge archive dedicated to Indian armed forces personnel and public servants",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix backend run typecheck",
    "test": "npm --prefix backend run test",
    "test:e2e": "npm --prefix e2e test",
    "db:generate": "npm --prefix database run prisma:generate",
    "db:validate": "npm --prefix database run prisma:validate",
    "db:migrate": "npm --prefix database run prisma:migrate",
    "db:seed": "npm --prefix database run prisma:seed",
    "db:studio": "npm --prefix database run prisma:studio",
    "db:reset": "npm --prefix database run prisma:reset"
  },
  "keywords": [
    "memorial",
    "archive",
    "indian-army",
    "tribute"
  ],
  "author": "",
  "license": "MIT"
}

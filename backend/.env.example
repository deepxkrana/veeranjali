# Server Configuration
PORT=3000
NODE_ENV=development

# Database (from Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/veeranjali?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/veeranjali?sslmode=require"

# Authentication
SESSION_SECRET="your-secure-session-secret-minimum-32-characters-long"

# Frontend
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="info"
